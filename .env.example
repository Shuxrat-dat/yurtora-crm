# Django settings
# Внимание: для production сгенерируйте уникальный SECRET_KEY и установите DEBUG=False
# Все значения ниже — плейсхолдеры. Замените их в своём .env, в репозиторий не коммитьте.
SECRET_KEY=change-me-generate-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL settings
POSTGRES_DB=yurtora_crm
POSTGRES_USER=yurtora_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection URL (используется django-environ)
DATABASE_URL=postgres://yurtora_user:change-me-db-password@db:5432/yurtora_crm

# --- Production (docker-compose.prod.yml) ---
# DEBUG=False, SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(60))"
# ALLOWED_HOSTS=.yurtora.uz,web,localhost      # nuqta bilan: asosiy domen va barcha markaz manzillari
# CSRF_TRUSTED_ORIGINS=https://yurtora.uz,https://*.yurtora.uz

# --- Telegram bot (qarz eslatmalari) ---
# @BotFather orqali bot yarating; token faqat .env da saqlanadi, repozitoriyga yozilmaydi.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=yurtora_crm_bot   # bitta bot barcha markazlar uchun
# TELEGRAM_REMINDER_COOLDOWN_DAYS=3
# TELEGRAM_DIGEST_WEEKDAY=0   # haftalik ro'yxat kuni (0 = dushanba)
# TELEGRAM_DIGEST_HOUR=9       # soat (Asia/Tashkent)

# --- Production: domen, HTTPS va zaxira nusxalar (docker-compose.prod.yml) ---
# ROOT_DOMAIN=yurtora.uz           # markazlar <nom>.yurtora.uz manzilida; DNS: yurtora.uz va *.yurtora.uz -> server IP
#                                  # Caddy har bir manzil uchun HTTPS sertifikatini o'zi oladi
# YURTORA_SUPPORT=+998 90 000 00 00 / @yurtora_support   # obuna/to'lov bo'yicha bog'lanish (bloklangan va Obuna sahifalarida)
# POSTGRES_PASSWORD faqat harf va raqamlardan iborat bo'lsin (DATABASE_URL ichida ishlatiladi)
# BACKUP_KEEP_DAYS=14
# BACKUP_COPY_DIR=/offsite          # serverdan tashqariga nusxa uchun (ikkinchi disk/NAS)
# BACKUP_COPY_HOST_DIR=/mnt/nas/yurtora-backups
# BACKUP_UPLOAD_CMD=                # ixtiyoriy: masalan rclone copyto "$BACKUP_FILE" remote:yurtora/

# Jurnal darajasi: INFO (standart), WARNING yoki DEBUG
# LOG_LEVEL=INFO
